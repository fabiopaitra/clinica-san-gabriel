# Vídeo do hero (Vercel Blob CDN)
# Após upload: vercel blob put public/clinica-san-gabriel.mp4
# Copie a URL retornada e adicione nas variáveis de ambiente do Vercel
NEXT_PUBLIC_HERO_VIDEO_URL=

# Analytics (ver docs/ANALYTICS.md). Configure só em Production no Vercel.
# GA4: Admin → Data streams → Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Hotjar: Sites & Organizations → Site ID
NEXT_PUBLIC_HOTJAR_SITE_ID=
# PostHog: Project settings → Project token (phc_...) e região (us ou eu)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_REGION=us
